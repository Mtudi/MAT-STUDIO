{
  "rewrites": [
    {
      "source": "/engine/stockfish-19-lite-single.js",
      "destination": "https://unpkg.com/stockfish@19.0.1/bin/stockfish-19-lite-single.js"
    },
    {
      "source": "/engine/stockfish-19-lite-single.wasm",
      "destination": "https://unpkg.com/stockfish@19.0.1/bin/stockfish-19-lite-single.wasm"
    }
  ],
  "headers": [
    {
      "source": "/engine/stockfish-19-lite-single.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/engine/stockfish-19-lite-single.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
