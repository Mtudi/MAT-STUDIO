{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/xi-chat.js": {
      "maxDuration": 60
    },
    "api/xi-auth.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/projects/chess-lab/engine/stockfish-19-lite-single.js",
      "destination": "https://cdn.jsdelivr.net/npm/stockfish@19.0.1/bin/stockfish-19-lite-single.js"
    },
    {
      "source": "/projects/chess-lab/engine/stockfish-19-lite-single.wasm",
      "destination": "https://cdn.jsdelivr.net/npm/stockfish@19.0.1/bin/stockfish-19-lite-single.wasm"
    }
  ],
  "headers": [
    {
      "source": "/projects/chess-lab/engine/stockfish-19-lite-single.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/projects/chess-lab/engine/stockfish-19-lite-single.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
